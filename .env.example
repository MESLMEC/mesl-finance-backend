# Copy to .env (never commit .env). All keys use the MESL_ prefix.
# The app connects as the limited 'labapp' role, never as the owner.
MESL_DATABASE_URL=postgresql+asyncpg://labapp:change-me@localhost:5432/mesl
# owner DSN, used only by migrations, bootstrap and tests - never the running app
MESL_ADMIN_DATABASE_URL=postgresql://postgres:change-me@localhost:5432/mesl
MESL_JWT_SECRET=replace-with-at-least-32-random-characters
MESL_JWT_TTL_HOURS=72
MESL_AUTH_USERNAME=treasurer
# make with: uv run python -m mesl_finance.auth.infrastructure.hash_cli
MESL_AUTH_PASSWORD_HASH=
MESL_TIMEZONE=Asia/Dhaka
